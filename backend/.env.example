# ==============================================================================
# NeuroFlow Backend Environment Configuration
# Copy this file to .env for local development or set in Render Environment Variables
# ==============================================================================

# ------------------------------------------------------------------------------
# Database Connection (DATABASE_URL)
# ------------------------------------------------------------------------------
# Local SQLite development:
DATABASE_URL=sqlite:///./neuroflow.db

# Neon PostgreSQL (Direct or Pooled):
# DATABASE_URL=postgresql://user:password@ep-cool-fog-123456.us-east-2.aws.neon.tech/neondb?sslmode=require

# Supabase PostgreSQL (Connection Pooler - Port 5432 for Session Mode / Migrations):
# DATABASE_URL=postgresql://postgres.your-project-ref:your-strong-password@aws-0-us-east-1.pooler.supabase.com:5432/postgres?sslmode=require

# IMPORTANT NOTES FOR POSTGRESQL ON RENDER / SUPABASE / NEON:
# 1. Driver prefix MUST be 'postgresql://' or 'postgresql+psycopg2://'. Do NOT use 'postgresql+asyncpg://'.
#    (If Render/Supabase provides 'postgres://', the backend automatically converts it to 'postgresql://').
# 2. Always append '?sslmode=require' for Neon and Supabase.
# 3. URL-encode special characters in the password (e.g. '@' -> '%40', '#' -> '%23', '!' -> '%21').

# ------------------------------------------------------------------------------
# Google Gemini API Key (GEMINI_API_KEY)
# ------------------------------------------------------------------------------
# Obtain from Google AI Studio: https://aistudio.google.com/app/apikey
# Required for AI schedule proposals and goal decomposition features.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-3.8-flash

# ------------------------------------------------------------------------------
# Allowed CORS Origins (ALLOWED_ORIGINS or CORS_ORIGINS)
# ------------------------------------------------------------------------------
# Comma-separated list of allowed origins, or JSON array format.
# Include both your production frontend URL (e.g. Vercel) and localhost for testing.
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,https://your-frontend.vercel.app

# ------------------------------------------------------------------------------
# Application Environment & Logging
# ------------------------------------------------------------------------------
# Set to 'production' on Render; 'development' for local work
ENVIRONMENT=development
LOG_LEVEL=INFO
